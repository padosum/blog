{
  "name": "padosum-wiki",
  "version": "1.0.0",
  "description": "Padosum 개인 위키 — 직접 만든 SSG",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n build,js,serve -c blue,magenta,green \"tsx watch src/build/index.ts --dev\" \"vite build --watch\" \"vite\"",
    "build": "tsx src/build/index.ts && vite build",
    "preview": "vite preview",
    "validate:rune": "tsx src/build/_validate-rune.ts",
    "scan": "tsx src/build/scan.ts",
    "render": "tsx src/build/pipeline.ts",
    "validate:pipeline": "tsx src/build/_validate-pipeline.ts",
    "clean": "rimraf dist .vite"
  },
  "dependencies": {
    "@flowershow/remark-wiki-link": "^3.4.0",
    "fs-extra": "^11.3.0",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "lodash-es": "^4.17.21",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rune-ts": "^0.9.3",
    "shiki": "^3.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
